Options -Indexes

RewriteEngine On

# Redirect ke HTTPS (aktifkan jika server pakai SSL)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Jangan redirect file/folder yang memang ada secara fisik
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Semua request diarahkan ke index.php
# Bekerja di subfolder manapun tanpa perlu ubah RewriteBase
RewriteRule ^ index.php [QSA,L]